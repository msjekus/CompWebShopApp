@using CompWebShopApp.Model.ViewModels.Home
@model HomeIndexVM
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<h1>Каталог товарів</h1>
@if (Model.Products != null && Model.Products.Any())
{
    <div class="row row-cols-1 row-cols-ms-2 row-cols-md-3">
        @foreach(var product in Model.Products)
        {
            <div class="col">
                <div class="card shadow-sm">
                    <img src="data:image/*;base64,@(Convert.ToBase64String(product.ProductImages.FirstOrDefault()!.ImageData))"
                    alt="@product.ProductName" class="bd-placeholder-img card-img-top" style="height: 225px" />
                    <div class="card-body">
                        <p class="card-text">This is a wider card with supporting text below as a natural lead-in to additional content. This content is a little bit longer.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-outline-secondary">View</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary">Edit</button>
                            </div>
                            <small class="text-body-secondary">9 mins</small>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
	<h3>Товари відсутні</h3>
}